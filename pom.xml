<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.passimoritz</groupId>
  <artifactId>voiceapi</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>VoiceAPI</name>
  <description>Speech and singing from villager sounds for Bukkit servers (Spigot, Paper, Purpur, Folia, Minecraft 1.17+): text (German, English) becomes sounds, stress and melody; with the resource pack real vowels and AI villager singing.</description>
  <url>https://github.com/Passimoritz/MC-VoiceAPI</url>

  <properties>
    <!--
      Runs on every Bukkit server from Minecraft 1.17 (Spigot, Paper, Purpur, Folia …) and stays valid without maintenance:
      - Java 17 as the target (Minecraft 1.17 – 1.20.4 run on Java 17, newer ones on 21+; every newer Java runs Java 17 classes)
      - compiled against the OLDEST supported Spigot API: what compiles here exists on all servers
      - only a small part of the Bukkit API that has been stable for years, no server-internal code (NMS), versions are never queried
      - CI additionally compiles and tests every week against the NEWEST Paper/Spigot API (profiles paper-latest, spigot-latest)
    -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <revision>1.9.0</revision>
    <bukkit.groupId>org.spigotmc</bukkit.groupId>
    <bukkit.artifactId>spigot-api</bukkit.artifactId>
    <bukkit.version>1.17.1-R0.1-SNAPSHOT</bukkit.version>
    <junit.version>6.1.3</junit.version>
    <!-- The sounds (23 MB, 98 % of a jar) are downloaded by the plugin on first start (release "voice-pack", SoundDownload); -P bundled-pack puts them back into the jar -->
    <voiceapi.pack.include>none</voiceapi.pack.include>
  </properties>

  <repositories>
    <repository>
      <id>spigotmc</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>${bukkit.groupId}</groupId>
      <artifactId>${bukkit.artifactId}</artifactId>
      <version>${bukkit.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Cross-check: the same sources against the newest Paper API (-Dbukkit.version=<version>, CI fills in the newest one) -->
    <profile>
      <id>paper-latest</id>
      <properties>
        <bukkit.groupId>io.papermc.paper</bukkit.groupId>
        <bukkit.artifactId>paper-api</bukkit.artifactId>
      </properties>
    </profile>
    <!-- Cross-check: newest Spigot API (-Dbukkit.version=<version>-R0.1-SNAPSHOT) -->
    <profile>
      <id>spigot-latest</id>
    </profile>
    <!-- A jar with the sounds inside (~24 MB) for servers that may not download anything: nothing is downloaded then -->
    <profile>
      <id>bundled-pack</id>
      <properties>
        <voiceapi.pack.include>pack/**</voiceapi.pack.include>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <!-- java -jar voiceapi.jar … speaks text without a server into a .voice file or a cue list (for tools/voicelab.py) -->
              <mainClass>de.passimoritz.voiceapi.tool.VoiceTool</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <excludes>
          <exclude>pack/**</exclude>
        </excludes>
      </resource>
      <!-- The finished sounds (resource pack part): not in the normal jar (downloaded, see voiceapi.pack.include); binary, do not filter -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>${voiceapi.pack.include}</include>
        </includes>
      </resource>
      <!-- The tools (build the pack, render samples, voice model) are unpacked to plugins/VoiceAPI/tools/ on start -->
      <resource>
        <directory>tools</directory>
        <targetPath>tools</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>*.py</include>
          <include>*.json</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
