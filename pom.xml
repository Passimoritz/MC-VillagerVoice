<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.passimoritz</groupId>
  <artifactId>voiceapi</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>VoiceAPI</name>
  <description>Sprache und Gesang aus Dorfbewohner-Lauten für Paper (Minecraft 26.3): Text (Deutsch, Englisch) wird zu Lauten, Betonung und Melodie und mit Vanilla-Klängen gesprochen – mit dem NoteAPI-Ressourcenpaket auch mit echten Vokalen.</description>
  <url>https://github.com/Passimoritz/MC-VoiceAPI</url>

  <properties>
    <!--
      Läuft auf jedem Bukkit-Server ab Minecraft 1.17 (Spigot, Paper, Purpur, Folia …) und bleibt ohne Pflege gültig:
      - Java 17 als Ziel (Minecraft 1.17 – 1.20.4 laufen auf Java 17, neuere auf 21+; jedes neuere Java führt Java-17-Klassen aus)
      - übersetzt gegen die ÄLTESTE unterstützte Spigot-API: was hier übersetzt, gibt es auf allen Servern
      - nur ein kleiner, seit Jahren stabiler Teil der Bukkit-API, kein Server-interner Code (NMS), Versionen werden nie abgefragt
      - die CI übersetzt und testet zusätzlich jede Woche gegen die jeweils NEUESTE Paper-/Spigot-API (Profile paper-latest, spigot-latest)
    -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <revision>1.3.1</revision>
    <bukkit.groupId>org.spigotmc</bukkit.groupId>
    <bukkit.artifactId>spigot-api</bukkit.artifactId>
    <bukkit.version>1.17.1-R0.1-SNAPSHOT</bukkit.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>spigotmc</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>${bukkit.groupId}</groupId>
      <artifactId>${bukkit.artifactId}</artifactId>
      <version>${bukkit.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Gegenprobe: dieselben Quellen gegen die neueste Paper-API (-Dbukkit.version=<Version>, die CI setzt die jeweils neueste ein) -->
    <profile>
      <id>paper-latest</id>
      <properties>
        <bukkit.groupId>io.papermc.paper</bukkit.groupId>
        <bukkit.artifactId>paper-api</bukkit.artifactId>
      </properties>
    </profile>
    <!-- Gegenprobe: neueste Spigot-API (-Dbukkit.version=<Version>-R0.1-SNAPSHOT) -->
    <profile>
      <id>spigot-latest</id>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <!-- java -jar voiceapi.jar … spricht Text ohne Server in eine .voice-Datei oder eine Cue-Liste (für tools/voicelab.py) -->
              <mainClass>de.passimoritz.voiceapi.tool.VoiceTool</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <excludes>
          <exclude>pack/**</exclude>
        </excludes>
      </resource>
      <!-- Die fertigen Laute (Ressourcenpaket-Teil): binär, nicht filtern. Die NoteAPI mischt sie in ihr Paket -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>pack/**</include>
        </includes>
      </resource>
      <!-- Die Werkzeuge (Paket bauen, Hörproben rendern) werden beim Start nach plugins/VoiceAPI/tools/ ausgepackt -->
      <resource>
        <directory>tools</directory>
        <targetPath>tools</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>*.py</include>
          <include>*.json</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
