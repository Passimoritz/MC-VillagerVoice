<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.passimoritz</groupId>
  <artifactId>voiceapi</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>VoiceAPI</name>
  <description>Sprache und Gesang aus Dorfbewohner-Lauten für Paper (Minecraft 26.3): Text (Deutsch, Englisch) wird zu Lauten, Betonung und Melodie und mit Vanilla-Klängen gesprochen – mit dem NoteAPI-Ressourcenpaket auch mit echten Vokalen.</description>
  <url>https://github.com/Passimoritz/MC-VoiceAPI</url>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <revision>1.1.0</revision>
    <!-- Dieselbe Paper-API wie NoteAPI und Firefight -->
    <paper.api.version>26.3-pre-2.build.0-alpha</paper.api.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <!-- java -jar voiceapi.jar … spricht Text ohne Server in eine .voice-Datei oder eine Cue-Liste (für tools/voicelab.py) -->
              <mainClass>de.passimoritz.voiceapi.tool.VoiceTool</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <excludes>
          <exclude>pack/**</exclude>
        </excludes>
      </resource>
      <!-- Die fertigen Laute (Ressourcenpaket-Teil): binär, nicht filtern. Die NoteAPI mischt sie in ihr Paket -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>pack/**</include>
        </includes>
      </resource>
      <!-- Die Werkzeuge (Paket bauen, Hörproben rendern) werden beim Start nach plugins/VoiceAPI/tools/ ausgepackt -->
      <resource>
        <directory>tools</directory>
        <targetPath>tools</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>*.py</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
